# SkillCarry Environment Configuration
# Copy this file to .env.local for local overrides (never commit .env.local to Git)

# Application metadata
VITE_APP_NAME=SkillCarry
VITE_APP_ENV=development

# Optional External AI Service (SkillCarry runs fully offline using its built-in rule-based recommendation engine)
# If integrating Google Gemini or OpenAI in the future, set your API key here:
# VITE_GEMINI_API_KEY=your_gemini_api_key_here
